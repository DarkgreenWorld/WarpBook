{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "Panicnot42",
        "FerreusVeritas",
        "MelonVRneu",
        "ArcAnc",
        "DarkgreenWorld"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/warp-book",
        "sources": "https://github.com/DarkgreenWorld/WarpBook",
        "issues": "https://github.com/DarkgreenWorld/WarpBook/issues"
    },
    "license": "${license}",
    "icon": "assets/warp_book/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.panicnot42.warp_book.WarpBook"
        ],
        "client": [
            "com.panicnot42.warp_book.util.ClientHandler"
        ]
    },
    "mixins": [
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
